# Ambiente da demo publica. Copiar para /etc/concession-demo/demo.env
# (root:root, 600) e trocar todo <...>. Nunca commitar o arquivo real.
# Runbook: docs/runbooks/public-demo.md
APP_NAME=concession
APP_ENV=production
DEFAULT_DOMAIN=concessoes-manutencao
DOMAINS_PATH=domains

# Demo publica: qualquer visitante entra na /team como o operador ficticio.
# A aplicacao recusa subir se algum canal de envio externo estiver ligado.
ENABLE_PUBLIC_DEMO_LOGIN=true
ENABLE_SUPPORT_CONSOLE=true
ENABLE_TEAM_UI=true
ENABLE_AI_INTAKE=true
ENABLE_PUBLIC_CHAT_UI=true
ENABLE_TEAM_DEV_LOGIN=false

# Banco dedicado, so local, recriado todo dia pelo timer de reset.
PERSISTENCE_BACKEND=postgres
DATABASE_URL=postgresql://concession_demo:<senha-do-banco>@127.0.0.1:5432/concession_demo
RETRIEVAL_BACKEND=lexical
SESSION_DOMAIN_STORE_BACKEND=memory
WEB_AUTH_STORAGE_BACKEND=memory

# Segredos gerados na VPS (openssl rand -hex 32), todos diferentes.
API_SECRET_KEY=<gerar>
PERSISTENCE_HASH_SECRET=<gerar>
IDENTITY_HASH_SECRET=<gerar>
OTP_DIGEST_SECRET=<gerar>

# LLM: a chave e colocada pelo dono da conta, direto neste arquivo na VPS.
# Configure antes um limite de gasto no projeto da OpenAI.
OPENAI_API_KEY=<chave-do-projeto-openai>

# Limites para trafego publico (por IP real, via --proxy-headers).
WEB_CHAT_RATE_LIMIT_PER_MINUTE=6
RATE_LIMIT_PER_MINUTE=10
WEB_CHAT_COOKIE_SECURE=true
SUPPORT_CONSOLE_TIMEZONE=America/Sao_Paulo

# Tudo que envia algo para fora fica desligado (a aplicacao confere no boot).
ENABLE_WEB_WHATSAPP_AUTH=false
ENABLE_META_WHATSAPP_CHAT=false
ENABLE_META_WHATSAPP_WEBHOOK=false
ENABLE_HERMES_CHAT=false
ENABLE_OUTBOX_INGRESS=false
ENABLE_SUPPORT_TEAM_WHATSAPP_NOTIFY=false
ENABLE_WHATSAPP_SUPPORT_NUMBER=false
ENABLE_CONVERSATION_ARCHIVE=false
WEB_AUTH_OTP_DELIVERY_TRANSPORT=memory
